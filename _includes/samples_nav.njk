            <li{% if page.url == '/demo/substack/www.columnblog.com/p/washington-post-continues-to-lie/' %} class="active"{% endif %}><a href="/demo/substack/www.columnblog.com/p/washington-post-continues-to-lie/">Post Continues to Lie About Social Security and Life Expectancy</a></li>
            <li{% if page.url == '/demo/substack/www.columnblog.com/p/3-media-tactics-the-right-will-use/' %} class="active"{% endif %}><a href="/demo/substack/www.columnblog.com/p/3-media-tactics-the-right-will-use/">3 Media Tactics the Right Will Use to Undermine Brandon Johnson</a></li>
        </ul>
    </li>
    <li{% if '/heathercoxrichardson.substack.com/' in page.url %} class="active"{% endif %}><strong>Heather Cox Richardson</strong>: Boston College (History Professor)
        <ul>
            <li{% if page.url == '/demo/substack/heathercoxrichardson.substack.com/p/january-19-2026/' %} class="active"{% endif %}><a href="/demo/substack/heathercoxrichardson.substack.com/p/january-19-2026/">January 19, 2026</a></li>
        </ul>
    </li>
    </ul>
</div>
<script>
(function() {
    var path = window.location.pathname.replace(/\/$/, '');
    document.querySelectorAll('.sample-articles ul.disc li ul li').forEach(function(li) {
        var a = li.querySelector('a');
        if (a && a.getAttribute('href').replace(/\/$/, '') === path) {
            li.classList.add('active');
            li.parentElement.closest('li').classList.add('active');
        }
    });
})();
</script>
<!--*************** End: CiteIt Samples *****************-->
