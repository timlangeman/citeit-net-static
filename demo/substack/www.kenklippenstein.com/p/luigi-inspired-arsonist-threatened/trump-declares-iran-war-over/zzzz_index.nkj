ood,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F94ab891a-2c32-489f-9faa-d483f2fd8ff8_1170x1170.jpeg"}}],"publisher":{"@type":"Organization","name":"Ken Klippenstein","url":"https://www.kenklippenstein.com","description":"No-nonsense reporting on the U.S. national security state and politics.","interactionStatistic":{"@type":"InteractionCounter","name":"Subscribers","interactionType":"https://schema.org/SubscribeAction","userInteractionCount":100000},"identifier":"pub:7677","logo":{"@type":"ImageObject","url":"https://substackcdn.com/image/fetch/$s_!FIP3!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png","contentUrl":"https://substackcdn.com/image/fetch/$s_!FIP3!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png","thumbnailUrl":"https://substackcdn.com/image/fetch/$s_!FIP3!,w_128,h_128,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png"},"image":{"@type":"ImageObject","url":"https://substackcdn.com/image/fetch/$s_!FIP3!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png","contentUrl":"https://substackcdn.com/image/fetch/$s_!FIP3!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png","thumbnailUrl":"https://substackcdn.com/image/fetch/$s_!FIP3!,w_128,h_128,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F356991b6-9095-402d-8a80-9f0b3873de6d_1280x1280.png"},"sameAs":["https://twitter.com/kenklippenstein"]},"interactionStatistic":[{"@type":"InteractionCounter","interactionType":"https://schema.org/LikeAction","userInteractionCount":605},{"@type":"InteractionCounter","interactionType":"https://schema.org/ShareAction","userInteractionCount":136},{"@type":"InteractionCounter","interactionType":"https://schema.org/CommentAction","userInteractionCount":40}]}</script><div aria-label="Post" role="main" class="single-post-container"><div class="container"><div class="single-post"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><article class="typography newsletter-post post"><div role="region" aria-label="Post header" class="post-header">
                <h1 dir="auto" class="post-title published title-X77sOw">Trump Declares Iran War Over</h1>
                <h3 dir="auto" class="subtitle subtitle-HEEcLo">But World War III continues</h3>
